/* =====================================================
   FUNÇÃO DE RETIRADA
===================================================== */

create or replace function public.retirar_medicamento(

    p_medicamento_id bigint,

    p_usuario text,

    p_quantidade integer

)

returns json

language plpgsql

security definer

set search_path = public

as $$

declare

    v_medicamento public.medicamentos%rowtype;

    v_novo_estoque integer;

begin


    /* -------------------------
       VALIDAR USUÁRIO
    ------------------------- */

    if p_usuario is null
       or trim(p_usuario) = '' then

        raise exception
            'Usuário não informado';

    end if;


    /* -------------------------
       VALIDAR QUANTIDADE
    ------------------------- */

    if p_quantidade not in
        (1, 5, 15, 20) then

        raise exception
            'Quantidade inválida';

    end if;


    /* -------------------------
       PEGAR MEDICAMENTO
       E BLOQUEAR A LINHA
    ------------------------- */

    select *

    into v_medicamento

    from public.medicamentos

    where id = p_medicamento_id

    for update;


    if not found then

        raise exception
            'Medicamento não encontrado';

    end if;


    /* -------------------------
       VERIFICAR ESTOQUE
    ------------------------- */

    if v_medicamento.estoque
       < p_quantidade then

        raise exception
            'Estoque insuficiente';

    end if;


    /* -------------------------
       NOVO ESTOQUE
    ------------------------- */

    v_novo_estoque :=
        v_medicamento.estoque
        - p_quantidade;


    /* -------------------------
       ATUALIZAR ESTOQUE
    ------------------------- */

    update public.medicamentos

    set estoque =
        v_novo_estoque

    where id =
        p_medicamento_id;


    /* -------------------------
       REGISTRAR RETIRADA
    ------------------------- */

    insert into public.retiradas
    (
        usuario,
        medicamento_id,
        medicamento_nome,
        quantidade
    )

    values
    (
        p_usuario,
        p_medicamento_id,
        v_medicamento.nome,
        p_quantidade
    );


    /* -------------------------
       RETORNAR RESULTADO
    ------------------------- */

    return json_build_object(

        'sucesso',
        true,

        'estoque',
        v_novo_estoque

    );

end;

$$;


/* =====================================================
   PERMISSÃO PARA CHAMAR A FUNÇÃO
===================================================== */

grant execute
on function public.retirar_medicamento(
    bigint,
    text,
    integer
)

to anon, authenticated;


/* =====================================================
   RLS
===================================================== */

alter table public.medicamentos
enable row level security;


alter table public.retiradas
enable row level security;


/* =====================================================
   LEITURA DOS MEDICAMENTOS
===================================================== */

create policy
"permitir leitura medicamentos"

on public.medicamentos

for select

to anon, authenticated

using (true);


/* =====================================================
   LEITURA DO HISTÓRICO
===================================================== */

create policy
"permitir leitura retiradas"

on public.retiradas

for select

to anon, authenticated

using (true);


/* =====================================================
   PERMISSÕES DE LEITURA
===================================================== */

grant select
on public.medicamentos
to anon, authenticated;


grant select
on public.retiradas
to anon, authenticated;